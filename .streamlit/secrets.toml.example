# EVOLV: The Validation Factory — Streamlit Cloud Secrets Template
#
# Copy this file to .streamlit/secrets.toml for local use,
# OR paste the key-value pairs into the Streamlit Community Cloud
# "Secrets" panel (App Settings → Secrets).
#
# DO NOT commit secrets.toml to git.

# ── Demo access (optional — remove to disable password gate) ──────
DEMO_PASSWORD     = "your-password-here"

# ── Core AI services (required for URS generation / verification) ──
OPENAI_API_KEY    = "sk-..."
PINECONE_API_KEY  = "pcsk_..."

# ── Anthropic (required for SMART engine / Sentinel) ──────────────
ANTHROPIC_API_KEY = "sk-ant-..."

# ── EVOLV API server (required for Navigator page only) ────────────
# Leave unset when running Streamlit standalone (Navigator page
# will show an unavailable notice instead of a broken iframe).
# EVOLV_API_URL = "https://your-api.example.com"
